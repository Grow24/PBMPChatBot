# ============================================
# PBMP Backend Environment Variables
# ============================================

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key_here
# Optional; defaults to gemini-2.5-flash (do NOT use gemini-2.0-flash — deprecated)
GEMINI_MODEL=gemini-2.5-flash

# AstraDB Configuration
ASTRA_DB_API_ENDPOINT=https://your-database-id-region.apps.astra.datastax.co
ASTRA_DB_APPLICATION_TOKEN=AstraCS:your_token_here
ASTRA_DB_NAMESPACE=default_keyspace
PBMP_ASTRA_DB_COLLECTION=pbmp_chat

# Email Configuration
# Option A (recommended to start): Gmail SMTP with an App Password
EMAIL_SERVICE=gmail
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASSWORD=your-16-char-gmail-app-password
EMAIL_FROM=your-gmail@gmail.com
EMAIL_LOGO_URL=https://yourdomain.com/logo.png
#
# Option B: any SMTP provider (Resend, Brevo, etc.)
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=587
# SMTP_USER=resend
# SMTP_PASS=re_your_api_key
# EMAIL_FROM=Grow24 <noreply@yourdomain.com>
#
# Option C (legacy): SendGrid — only used if Gmail/SMTP above are not set
# SENDGRID_API_KEY=SG.your-sendgrid-api-key-here

# Server Configuration
PORT=3000

# WhatsApp (WAPI) configuration
WAPI_URL=https://wapi.in.net/api
WAPI_VENDOR_UID=your_vendor_uid
WAPI_TOKEN=your_wapi_token
WEBHOOK_VERIFY_TOKEN=your_verify_token
PBMP_API_URL=http://localhost:3000/api/chat

# Official WAPI paths (verified)
WAPI_SEND_MESSAGE_PATH=contact/send-message
WAPI_SEND_MEDIA_PATH=contact/send-media-message
WAPI_SEND_TEMPLATE_PATH=contact/send-template-message
WAPI_SEND_INTERACTIVE_PATH=contact/send-interactive-message
# Prefer native 3-button menu when interactive API works; else text fallback
WAPI_PREFER_NATIVE_MENU=true
WAPI_INTERACTIVE_FALLBACK_TEXT=true
WAPI_MEDIA_VIA_SEND_MESSAGE=false

# Templates (Meta-approved name after WAPI sync)
WAPI_TEMPLATE_DEFAULT_LANGUAGE=en
# WAPI_DEFAULT_TEMPLATE_NAME=your_approved_template_name

# Optional: max media download size in MB for inbound media metadata fetch
MEDIA_MAX_DOWNLOAD_MB=15

# Idempotency / status / sessions
WHATSAPP_IDEMPOTENCY_TTL_MS=86400000
WHATSAPP_INBOUND_DEBOUNCE_MS=20000
WHATSAPP_STATUS_HISTORY_LIMIT=100
# WHATSAPP_SESSION_STORE=/tmp/pbmp-whatsapp-sessions.json

# 24h window + consent
WHATSAPP_CUSTOMER_CARE_WINDOW_MS=86400000
WHATSAPP_ENFORCE_WINDOW=true
WHATSAPP_CONSENT_STORE=/tmp/pbmp-whatsapp-consent.json
WHATSAPP_OPT_OUT_KEYWORDS=stop,unsubscribe,end,quit,optout,opt-out
WHATSAPP_OPT_IN_KEYWORDS=start,unstop,subscribe,optin,opt-in

# Links / forms (WhatsApp menu option 3)
WHATSAPP_WEBSITE_URL=https://grow24.ai
WHATSAPP_BOOKING_FORM_URL=https://pbmpchatbotbackend.zeabur.app/forms/booking.html
WHATSAPP_SUPPORT_FORM_URL=https://pbmpchatbotbackend.zeabur.app/forms/support.html
# PBMP_LEADS_URL=https://pbmpchatbotbackend.zeabur.app/api/leads

# WhatsApp Flows — first test in Meta Flow Builder (do not require WAPI yet)
# JSON: pbmp-backend/flows/lead-enquiry-flow.json  (Name / Company / Requirement)
# Guide: WHATSAPP_FLOWS_SETUP.md
# WHATSAPP_LEAD_FLOW_ID=
# WHATSAPP_LEAD_FLOW_SCREEN=LEAD_ENQUIRY
# WHATSAPP_BOOKING_FLOW_ID=
# WHATSAPP_BOOKING_FLOW_SCREEN=BOOKING_FORM
# WHATSAPP_SUPPORT_FLOW_ID=
# WHATSAPP_SUPPORT_FLOW_SCREEN=SUPPORT_FORM
# WHATSAPP_FLOW_CTA=Open Form

# Voice call (menu *5*) — click-to-call + callback (not WhatsApp VoIP Calling API)
# Use E.164 digits, e.g. 919876543210 (India)
WHATSAPP_VOICE_CALL_NUMBER=
WHATSAPP_VOICE_CALL_HOURS=Mon–Sat, 10:00–19:00 IST
WHATSAPP_VOICE_CALL_LABEL=Grow24 / PBMP
# WHATSAPP_VOICE_CALL_KEYWORDS=voice call,voice,phone call,call me,callback,call back,ring me
# WHATSAPP_CALLBACK_KEYWORDS=callback,call back,please call,call me back,ring me

# Android Automate POC — POST /whatsapp/automate (see AUTOMATE_POC.md)
# AUTOMATE_API_KEY=change-me-long-random
# AUTOMATE_DEFAULT_PHONE=919370239600

# Meta Developer App experiments (Calling + catalogue) — keep WAPI messaging unchanged
# META_APP_ID=
# META_ACCESS_TOKEN=
# META_PHONE_NUMBER_ID=
# META_WABA_ID=
# META_GRAPH_API_VERSION=v21.0
# WHATSAPP_CALLING_ENABLED=false
# reject inbound WhatsApp calls until a WebRTC media server exists (log = store only)
# WHATSAPP_CALLING_INBOUND_ACTION=reject
# WHATSAPP_FLOW_MODE=draft
# META_GRAPH_INTERACTIVE_FALLBACK=false
# WHATSAPP_CATALOGUE_ID=
# WHATSAPP_CATALOGUE_PRODUCT_IDS=sku-pbmp-1,sku-pbmp-2
# WHATSAPP_CATALOGUE_FALLBACK_TEXT=
# WAPI_SEND_CATALOGUE_PATH=contact/send-interactive-message

# Phase 5 — human handoff + CRM notify
# WHATSAPP_HANDOFF_WEBHOOK=https://hooks.example.com/pbmp-handoff
# WHATSAPP_HANDOFF_NOTIFY_EMAIL=team@grow24.ai
# WHATSAPP_HANDOFF_KEYWORDS=agent,human,talk to agent,talk to human,speak to human,customer care,support agent,real person
# WHATSAPP_RESUME_BOT_KEYWORDS=bot,resume,back to bot,ai,autobot

# Other section math (Python)
# PYTHON_BIN=python3

# Public base URL so WhatsApp/WAPI can fetch /media/image1.jpg
PUBLIC_BASE_URL=https://pbmpchatbotbackend.zeabur.app

# Phase 1 voice PWA hello-world (POST /api/voice/hello-world)
# Audio files are stored under pbmp-backend/voice-inbox/ (gitignored)
# VOICE_INBOX_DIR=
# VOICE_MAX_AUDIO_BYTES=8388608
# VOICE_INBOX_KEEP=20

# Optional: CDN URLs instead of files in media/ folder
# MEDIA_CMD_IMAGE1_URL=https://cdn.example.com/image1.jpg
# MEDIA_CMD_IMAGE2_URL=
# MEDIA_CMD_IMAGE3_URL=
# MEDIA_CMD_VIDEO1_URL=
# MEDIA_CMD_VIDEO2_URL=
# MEDIA_CMD_VIDEO3_URL=
# MEDIA_CMD_AUDIO1_URL=
# MEDIA_CMD_AUDIO2_URL=
# MEDIA_CMD_3D_IMAGE1_URL=
# MEDIA_CMD_3D_IMAGE2_URL=
# MEDIA_CMD_ANIMATED_IMAGE1_URL=
# MEDIA_CMD_ANIMATED_IMAGE2_URL=
# MEDIA_CMD_GIF1_URL=
# MEDIA_CMD_GIF2_URL=
