{
  "expo": {
    "name": "PBMP Voice",
    "slug": "pbmp-voice",
    "version": "0.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "pbmpvoice",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#020617"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "ai.grow24.pbmp.voice",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "PBMP Voice uses the microphone to hear Hey PBMP and capture your command.",
        "NSSpeechRecognitionUsageDescription": "PBMP Voice uses speech recognition to detect Hey PBMP.",
        "UIBackgroundModes": ["audio"]
      }
    },
    "android": {
      "package": "ai.grow24.pbmp.voice",
      "adaptiveIcon": {
        "backgroundColor": "#020617",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "RECORD_AUDIO",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_MICROPHONE",
        "POST_NOTIFICATIONS",
        "WAKE_LOCK",
        "MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "PBMP Voice uses the microphone to hear Hey PBMP.",
          "enableBackgroundRecording": true,
          "enableBackgroundPlayback": true
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "PBMP Voice uses the microphone to hear Hey PBMP.",
          "speechRecognitionPermission": "PBMP Voice uses speech recognition to detect Hey PBMP.",
          "androidSpeechServicePackages": ["com.google.android.googlequicksearchbox"]
        }
      ]
    ]
  }
}
